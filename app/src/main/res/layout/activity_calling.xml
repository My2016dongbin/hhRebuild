<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:binding="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="viewModel"
            type="com.haohai.platform.fireforestplatform.ui.viewmodel.CallingViewModel" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context=".NewsViewModel">
        <!--通话中-->
        <LinearLayout
            android:id="@+id/ll_speaking"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            tools:context=".NewsViewModel">
            <include
                android:id="@+id/top_bar"
                layout="@layout/view_top_bar"
                binding:onLeftClick ="@{viewModel.barLeftClick}"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardPreventCornerOverlap="false"
                app:cardUseCompatPadding="true">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/black"
                    android:layout_margin="7dp">

                    <com.netease.lava.nertc.sdk.video.NERtcVideoView
                        android:id="@+id/top_video"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <TextView
                        android:id="@+id/leader_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/leader_conner"
                        android:layout_margin="15dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="1dp"
                        android:paddingBottom="1dp"
                        android:text=""
                        android:textColor="@color/whiteColor"
                        android:textSize="12sp" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>
            
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/video_list"
                android:background="@color/back_calling"
                android:layout_marginTop="7dp"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="7dp"
                android:layout_width="match_parent"
                android:layout_height="125dp"/>
            <FrameLayout
                android:background="@color/back_calling"
                android:layout_marginTop="5dp"
                android:layout_width="match_parent"
                android:layout_height="80dp">

                <LinearLayout
                    android:id="@+id/audio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/audio_back"
                        android:layout_width="46dp"
                        android:layout_height="44dp"
                        android:background="@drawable/green_circle">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="25dp"
                            android:layout_gravity="center"
                            android:src="@drawable/icon_audio_call" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/audio_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="关闭语音"
                        android:textColor="@color/black"
                        android:textSize="11sp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/video"
                    android:layout_marginStart="84dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <FrameLayout
                        android:id="@+id/video_back"
                        android:background="@drawable/green_circle"
                        android:layout_width="44dp"
                        android:layout_height="44dp">
                        <ImageView
                            android:id="@+id/iv_video"
                            android:layout_gravity="center"
                            android:src="@drawable/video_on"
                            android:layout_width="24dp"
                            android:layout_height="33dp"/>
                    </FrameLayout>
                    <TextView
                        android:id="@+id/video_text"
                        android:layout_marginTop="3dp"
                        android:text="关闭视频"
                        android:textSize="11sp"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/person"
                    android:layout_marginEnd="84dp"
                    android:orientation="vertical"
                    android:layout_gravity="end"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <FrameLayout
                        android:background="@drawable/white_circle"
                        android:layout_width="44dp"
                        android:layout_height="44dp">
                        <ImageView
                            android:layout_gravity="center"
                            android:src="@drawable/icon_person_call"
                            android:layout_width="27dp"
                            android:layout_height="19dp"/>
                    </FrameLayout>
                    <TextView
                        android:layout_marginTop="3dp"
                        android:text="参会成员"
                        android:textSize="11sp"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/person_number"
                    android:layout_marginEnd="84dp"
                    android:layout_gravity="end"
                    android:gravity="center"
                    android:background="@drawable/red_circle_16"
                    android:textSize="10sp"
                    android:textColor="@color/whiteColor"
                    android:text="5"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"/>
                <FrameLayout
                    android:id="@+id/speaking_close"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/red_circle"
                    android:layout_width="92dp"
                    android:layout_height="46dp">
                    <ImageView
                        android:layout_gravity="center"
                        android:src="@drawable/icon_calling_close_width"
                        android:layout_width="28dp"
                        android:layout_height="9dp"/>
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>
        <!--呼叫中-->
        <FrameLayout
            android:id="@+id/fl_calling"
            android:visibility="gone"
            android:background="@color/black"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.netease.lava.nertc.sdk.video.NERtcVideoView
                android:id="@+id/calling_video"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <LinearLayout
                android:layout_marginTop="200dp"
                android:layout_gravity="center_horizontal"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:src="@drawable/icon"
                    android:layout_width="80dp"
                    android:layout_height="80dp"/>
                <TextView
                    android:id="@+id/call_name"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:textSize="14sp"
                    android:text=""
                    android:textColor="@color/whiteColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/call_status"
                    android:layout_marginTop="5dp"
                    android:textSize="12sp"
                    android:text="邀请您视频通话..."
                    android:textColor="@color/whiteColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/call_count"
                    android:layout_marginTop="50dp"
                    android:textSize="16sp"
                    android:text="00:12:22"
                    android:textColor="@color/whiteColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_gravity="bottom"
                android:gravity="center"
                android:layout_marginBottom="80dp"
                android:layout_marginStart="60dp"
                android:layout_marginEnd="60dp"
                android:layout_width="match_parent"
                android:layout_height="80dp">
                <!--拒绝-->
                <LinearLayout
                    android:id="@+id/calling_close"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_gravity="center"
                        android:src="@drawable/icon_close"
                        android:layout_width="60dp"
                        android:layout_height="60dp"/>
                    <TextView
                        android:id="@+id/calling_close_text"
                        android:layout_marginTop="5dp"
                        android:text="拒绝"
                        android:textSize="12sp"
                        android:textColor="@color/whiteColor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <!--占位-->
                <FrameLayout
                    android:id="@+id/calling_fl_space"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"/>
                <!--接听-->
                <LinearLayout
                    android:id="@+id/calling_open"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_gravity="center"
                        android:src="@drawable/icon_open"
                        android:layout_width="60dp"
                        android:layout_height="60dp"/>
                    <TextView
                        android:layout_marginTop="5dp"
                        android:text="接听"
                        android:textSize="12sp"
                        android:textColor="@color/whiteColor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

        </FrameLayout>
    </FrameLayout>
</layout>