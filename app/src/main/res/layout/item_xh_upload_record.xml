<?xml version="1.0" encoding="utf-8"?>
<layout>
    <data>
        <variable
            name="adapter"
            type="com.haohai.platform.fireforestplatform.ui.multitype.XhUploadRecordViewBinder" />
        <variable
            name="item"
            type="com.haohai.platform.fireforestplatform.ui.multitype.XhUploadRecord" />
    </data>

    <FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="94dp"
            android:background="@drawable/bg_xh_upload_record_card"
            android:elevation="2dp">

            <ImageView
                android:id="@+id/icon"
                android:layout_width="94dp"
                android:layout_height="match_parent"
                android:layout_centerVertical="true"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/ic_no_pic" />

            <TextView
                android:id="@+id/event_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginStart="10dp"
                android:layout_toEndOf="@id/icon"
                android:layout_toStartOf="@id/record_no"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_color3"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/event_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/event_name"
                android:layout_marginStart="10dp"
                android:layout_marginTop="7dp"
                android:layout_toEndOf="@id/icon"
                android:textColor="@color/text_color8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/event_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/event_time"
                android:layout_marginStart="10dp"
                android:layout_marginTop="6dp"
                android:layout_toEndOf="@id/icon"
                android:layout_toStartOf="@id/record_no"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_color6"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/record_no"
                android:layout_width="78dp"
                android:layout_height="28dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="0dp"
                android:background="@drawable/tab_slide"
                android:gravity="center"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textColor="@color/status_start"
                android:textSize="12sp" />
        </RelativeLayout>
    </FrameLayout>
</layout>
