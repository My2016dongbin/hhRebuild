<?xml version="1.0" encoding="utf-8"?>
<layout>
    <data>
        <variable
            name="adapter"
            type="com.haohai.platform.fireforestplatform.ui.multitype.XhUploadRecordViewBinder" />
        <variable
            name="item"
            type="com.haohai.platform.fireforestplatform.ui.multitype.XhUploadRecord" />
    </data>

    <FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="15dp"
        android:paddingTop="12dp"
        android:paddingEnd="15dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="102dp"
            android:background="@drawable/bg_xh_upload_record_card"
            android:padding="10dp">

            <ImageView
                android:id="@+id/icon"
                android:layout_width="84dp"
                android:layout_height="74dp"
                android:layout_centerVertical="true"
                android:background="@color/c0"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_no_pic" />

            <TextView
                android:id="@+id/event_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_toEndOf="@id/icon"
                android:layout_toStartOf="@id/record_no"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_color3"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/event_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/event_name"
                android:layout_marginStart="10dp"
                android:layout_marginTop="8dp"
                android:layout_toEndOf="@id/icon"
                android:textColor="@color/text_color3"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/event_address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/event_time"
                android:layout_marginStart="10dp"
                android:layout_marginTop="8dp"
                android:layout_toEndOf="@id/icon"
                android:layout_toStartOf="@id/record_no"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_color3"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/record_no"
                android:layout_width="58dp"
                android:layout_height="38dp"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="-10dp"
                android:background="@drawable/bg_xh_upload_record_no"
                android:gravity="center"
                android:lineSpacingExtra="1dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </RelativeLayout>
    </FrameLayout>
</layout>
